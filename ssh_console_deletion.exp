#!/usr/bin/expect -f
set password "Frappe@Hrms!"
spawn ssh -o StrictHostKeyChecking=no root@103.192.198.227 "cd /home/frappe/frappe-bench && bench --site aas.com console"
expect "password:"
send "$password\r"
expect "In \\\[1\\\]:"
send "import frappe\r"
expect "In \\\[2\\\]:"
send "from frappe.model.delete_doc import get_linked_docs\r"
expect "In \\\[3\\\]:"
send "def cleanup_and_delete_branches():\r"
send "    branches_to_delete = \['Dewas', 'Indore'\]\r"
send "    for branch_name in branches_to_delete:\r"
send "        if not frappe.db.exists('Branches', branch_name):\r"
send "            print(f'Branch {branch_name} does not exist.')\r"
send "            continue\r"
send "        print(f'Processing {branch_name}...')\r"
send "        links = get_linked_docs('Branches', branch_name)\r"
send "        if links:\r"
send "            print(f'Found links for {branch_name}:')\r"
send "            for dt, docs in links.items():\r"
send "                print(f'  {dt}: {docs}')\r"
send "                for docname in docs:\r"
send "                    try:\r"
send "                        meta = frappe.get_meta(dt)\r"
send "                        link_fields = \[f.fieldname for f in meta.fields if f.fieldtype == 'Link' and f.options == 'Branches'\]\r"
send "                        doc = frappe.get_doc(dt, docname)\r"
send "                        for field in link_fields:\r"
send "                            if doc.get(field) == branch_name:\r"
send "                                doc.set(field, None)\r"
send "                        doc.save(ignore_permissions=True)\r"
send "                        print(f'    Unhooked {branch_name} from {dt} {docname}')\r"
send "                    except Exception as ex:\r"
send "                        print(f'    Failed to unhook from {dt} {docname}: {str(ex)}')\r"
send "        try:\r"
send "            frappe.delete_doc('Branches', branch_name, ignore_missing=True, force=True)\r"
send "            frappe.db.commit()\r"
send "            print(f'Successfully deleted {branch_name}')\r"
send "        except Exception as e:\r"
send "            print(f'Error deleting {branch_name}: {str(e)}')\r"
send "\r"
expect "In \\\[4\\\]:"
send "cleanup_and_delete_branches()\r"
expect "Successfully deleted Indore"
send "exit()\r"
expect eof
